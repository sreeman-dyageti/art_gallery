<%- include("partials/header.ejs") %>

<% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
<div class="search-results-header">
    <p class="search-info">
        <% if (posts.length === 0) { %>
            No results for "<strong><%= searchQuery %></strong>" — <a href="/">see all posts</a>
        <% } else { %>
            <%= posts.length %> result<%= posts.length !== 1 ? 's' : '' %> for "<strong><%= searchQuery %></strong>"
        <% } %>
    </p>
</div>
<% } %>

<% if (posts.length === 0) { %>
<div class="empty-state">
    <div class="empty-icon">🎨</div>
    <h2 class="empty-title">The gallery is waiting for you</h2>
    <p class="empty-sub">Share your first artwork and start building your creative portfolio.</p>
    <a href="/new" class="btn-primary">
        <i class="fi fi-rr-plus"></i>
        Create Your First Post
    </a>
</div>
<% } else { %>

<div class="gallery-header">
    <h1 class="gallery-title">Explore <em>Artwork</em></h1>
    <p class="gallery-count"><%= posts.length %> <%= posts.length === 1 ? 'piece' : 'pieces' %> shared</p>
</div>

<div class="pinterest-grid" id="pinterestGrid">
    <% posts.forEach((post, i) => { %>
     <div class="p-item"></div>

        <a href="/posts/<%= post.id %>" class="p-img-link">
            <% const hasValidImage = post.image && post.image !== 'undefined' && post.image !== 'null'; %>
            <% if (hasValidImage) { %>
                <img src="<%= post.image %>"
                     alt="<%= post.title %>"
                     class="p-img"
                     loading="lazy">
            <% } else { %>
                <div class="p-no-img">🖼️</div>
            <% } %>

            <div class="p-hover">
                <% 
                  let stepCount = 0;
                  try {
                    const imgs = Array.isArray(post.process_images)
                      ? post.process_images
                      : JSON.parse(post.process_images || '[]');
                    stepCount = imgs.length;
                  } catch(e) { stepCount = 0; }
                %>
                <% if (stepCount > 0) { %>
                <span class="p-steps-badge">
                    <i class="fi fi-rr-layers"></i>
                    <%= stepCount %> steps
                </span>
                <% } %>
            </div>
        </a>

        <div class="p-info">
            <h3 class="p-title"><%= post.title %></h3>
            <p class="p-excerpt"><%= post.content %></p>
        </div>

        <div class="pin-actions">
            <a href="/edit/<%= post.id %>" class="pin-btn pin-btn-edit">
                <i class="fi fi-rr-pencil"></i> Edit
            </a>
            <form action="/delete/<%= post.id %>" method="post" class="inline-form">
                <button type="submit" class="pin-btn pin-btn-delete">
                    <i class="fi fi-rr-trash"></i> Delete
                </button>
            </form>
        </div>

    </div>
    <% }); %>
</div>

<% } %>

<%- include("partials/footer.ejs") %>