<%- include("partials/header.ejs") %>

<% if (posts.length === 0) { %>
<div class="empty-state">
 <div class="empty-icon">🎨</div>
 <h2 class="empty-title">The gallery is waiting for you</h2>
   <p class="empty-sub">Share your first artwork and start building your creative portfolio.</p>
   <a href="/new" class="btn-primary">
   <i class="fi fi-rr-plus"></i>
    Create Your First Post
        </a>
    </div>
<% } else { %>

<div class="gallery-header">
    <h1 class="gallery-title">Explore <em>Artwork</em></h1>
    <p class="gallery-count"><%= posts.length %> <%= posts.length === 1 ? 'piece' : 'pieces' %> shared</p>
</div>

<div class="masonry-grid">
    <% posts.forEach((post, index) => { %>
    <div class="pin-card" data-index="<%= index %>">
        <a href="/posts/<%= index %>" class="pin-image-wrap">
      <% const hasValidImage = post.image && post.image !== 'undefined' && post.image !== 'null'; %>
      <% if (hasValidImage) { %>
    <img src="<%= post.image %>" alt="<%= post.title %>" class="pin-img" loading="lazy">
     <% } else { %>
                <div class="pin-placeholder">
     <span class="placeholder-icon">🖼️</span>
                </div>
            <% } %>
            <div class="pin-overlay">
                <span class="pin-view-btn">View</span>
            </div>
        </a>

        <div class="pin-body">
            <h3 class="pin-title"><%= post.title %></h3>
            <p class="pin-excerpt"><%= post.content %></p>
        </div>

        <div class="pin-actions">
            <a href="/edit/<%= index %>" class="pin-btn pin-btn-edit">
                <i class="fi fi-rr-pencil"></i> Edit
            </a>
            <form action="/delete/<%= index %>" method="post" class="inline-form">
                <button type="submit" class="pin-btn pin-btn-delete">
                    <i class="fi fi-rr-trash"></i> Delete
                </button>
            </form>
        </div>
    </div>
    <% }); %>
</div>

<% } %>

<%- include("partials/footer.ejs") %>
