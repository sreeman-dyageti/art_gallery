<%- include("partials/header") %>
<div class="form-page">
    <div class="form-header">
        <div class="form-icon">✦</div>
        <h1 class="form-title">Share Your <em>Art</em></h1>
        <p class="form-subtitle">Document your creative process and inspire other artists.</p>
    </div>

    <form class="post-form" action="/create" method="post" enctype="multipart/form-data">
        <div class="field-group">
            <label class="field-label" for="title">Title</label>
            <input 
                type="text" 
                id="title"
                name="title" 
                placeholder="Name your artwork..." 
                required
                autocomplete="off"
            >
        </div>

        <div class="field-group">
            <label class="field-label" for="content-area">Artist's Note</label>
            <textarea 
                id="content-area" 
                name="content" 
                maxlength="500" 
                rows="5" 
                placeholder="Describe your creative process, the story behind this piece, techniques used..."
                required
            ></textarea>
            <div class="char-counter">
                <span id="charCount">0</span> / 500
            </div>
        </div>

        <div class="field-group">
            <label class="field-label">Process Images</label>

            <label class="file-drop" for="process-upload" id="processDropZone">
                <p class="drop-text">Upload your drawing steps</p>
                <p class="drop-hint">You can select multiple images to show your process</p>
                <div class="drop-preview" id="processPreview"></div>
            </label>

            <input
                type="file"
                id="process-upload"
                name="processImages"
                accept="image/*"
                class="file-input-hidden"
                multiple
            >
        </div>

        <button type="submit" class="submit-btn">
            <i class="fi fi-rr-paper-plane"></i>
            Publish to Gallery
        </button>
    </form>
</div>
<%- include("partials/footer") %>