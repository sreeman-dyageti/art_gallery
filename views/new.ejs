<%- include("partials/header") %>

<div class="form-page">
    <div class="form-header">
        <h1 class="form-title">Share Your <em>Art</em></h1>
        <p class="form-subtitle">Document your creative process and inspire other artists.</p>
    </div>

    <form class="post-form" action="/create" method="post" enctype="multipart/form-data">

        <div class="field-group">
            <label class="field-label" for="title">Title</label>
            <input type="text" id="title" name="title"
                   placeholder="Name your artwork..." required autocomplete="off">
        </div>

        <div class="field-group">
            <label class="field-label" for="content-area">Artist's Note</label>
            <textarea id="content-area" name="content" maxlength="500" rows="5"
                      placeholder="Describe your creative process, the story behind this piece..."
                      required></textarea>
            <div class="char-counter"><span id="charCount">0</span> / 500</div>
        </div>

        <!-- MAIN IMAGE -->
        <div class="field-group">
            <label class="field-label">Main Artwork Image</label>
            <div class="drop-zone" id="mainDropZone">
                <input type="file" id="mainImageInput" name="image"
                       accept="image/*" class="drop-input">
                <div class="drop-body" id="mainDropBody">
                  
                    <p class="drop-text">Click or drag & drop your main image</p>
                    <p class="drop-hint">JPG, PNG, GIF, WEBP</p>
                </div>
                <div class="drop-preview-single" id="mainPreview"></div>
            </div>
        </div>

        <!-- PROCESS IMAGES -->
        <div class="field-group">
            <label class="field-label">Creative Process Images
                <span class="field-sublabel">— show how this piece came to life (up to 10)</span>
            </label>
            <div class="drop-zone" id="processDropZone">
                <input type="file" id="processImagesInput" name="processImages"
                       accept="image/*" class="drop-input" multiple>
                <div class="drop-body" id="processDropBody">
                    
                    <p class="drop-text">Click or drag & drop process photos</p>
                    <p class="drop-hint">Upload multiple images — sketches, drafts, steps</p>
                </div>
            </div>
            <!-- Side-by-side previews grid -->
            <div class="process-preview-grid" id="processPreviewGrid"></div>
        </div>

        <button type="submit" class="submit-btn">
            <i class="fi fi-rr-paper-plane"></i>
            Publish to Gallery
        </button>
    </form>
</div>
<%- include("partials/footer") %>