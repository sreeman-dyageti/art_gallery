<%- include("partials/header") %>

<div class="form-page">
    <div class="form-header">
        <div class="form-icon"></div>
        <h1 class="form-title">Edit <em>Artwork</em></h1>
        <p class="form-subtitle">Refine your post and update your creative story.</p>
    </div>

    <form class="post-form" action="/update/<%= post.id %>" method="POST" enctype="multipart/form-data">

        <div class="field-group">
            <label class="field-label" for="title">Title</label>
            <input 
                type="text" 
                id="title"
                name="title" 
                value="<%= post.title %>" 
                placeholder="Name your artwork..." 
                required
                autocomplete="off"
            >
        </div>

        <div class="field-group">
            <label class="field-label" for="content-area">Artist's Note</label>
            <textarea 
                id="content-area" 
                name="content" 
                maxlength="500" 
                rows="5" 
                placeholder="Describe your process..."
                required
            ><%= post.content %></textarea>
            <div class="char-counter">
                <span id="charCount">0</span> / 500
            </div>
        </div>

        <div class="field-group">
            <label class="field-label">Artwork Image</label>

           <% if (post.image_url) { %>
           <img src="<%= post.image_url %>" alt="Current image" class="current-preview">
           <input type="hidden" name="existingImage" value="<%= post.image_url %>">
           <p class="drop-text"><%= post.image_url ? 'Click to replace image' : 'Click to upload image' %></p>
            <% } %>

            <label class="file-drop" for="image-upload" id="dropZone">
                <div class="drop-icon">🔄</div>
                <p class="drop-text"><%= post.image ? 'Click to replace image' : 'Click to upload image' %></p>
                <p class="drop-hint">JPG, PNG, GIF, WEBP supported</p>
                <div class="drop-preview" id="imagePreview"></div>
            </label>
            <input 
                type="file" 
                id="image-upload"
                name="image" 
                accept="image/*"
                class="file-input-hidden"
            >
        </div>

        <div class="form-actions">
            <a href="/" class="btn-ghost">Cancel</a>
            <button type="submit" class="submit-btn">
                <i class="fi fi-rr-check"></i>
                Save Changes
            </button>
        </div>
    </form>
</div>




<%- include("partials/footer") %>