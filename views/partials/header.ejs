<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Artfolio – Showcase Your Creative Process</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/3.0.0/uicons-regular-rounded/css/uicons-regular-rounded.css">
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/3.0.0/uicons-solid-rounded/css/uicons-solid-rounded.css">
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/3.0.0/uicons-brands/css/uicons-brands.css">
</head>
<body>

<header class="topbar">
    <a href="/" class="logo-link">
        <div class="logo">
            <div class="logo-mark">
                <span class="logo-diamond">◆</span>
            </div>
            <div class="logo-type">
                <span class="logo-text">Artfolio</span>
                <span class="logo-tagline">Creative Portfolio</span>
            </div>
        </div>
    </a>

    <!-- Search bar -->
    <form class="search-form" action="/search" method="GET">
        <div class="search-wrap">
            <i class="fi fi-rr-search search-icon"></i>
            <input
                type="text"
                name="q"
                class="search-input"
                placeholder="Search artworks..."
                value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                autocomplete="off"
            >
        </div>
    </form>

    <!-- Desktop nav -->
    <nav class="topbar-nav" id="desktopNav">
        <a href="/" class="nav-link">
            <i class="fi fi-rr-home"></i>
            <span>Explore</span>
        </a>

        <% if (currentUser) { %>
            <a href="/new" class="nav-link nav-cta">
                <i class="fi fi-rr-plus"></i>
                <span>New Post</span>
            </a>
            <a href="/profile/<%= currentUser.username %>" class="nav-link nav-avatar">
                <span class="avatar-circle">
                    <%= currentUser.username.charAt(0).toUpperCase() %>
                </span>
                <span><%= currentUser.username %></span>
            </a>
        <% } else { %>
            <a href="/login" class="nav-link">
                <i class="fi fi-rr-sign-in-alt"></i>
                <span>Login</span>
            </a>
            <a href="/register" class="nav-link nav-cta">
                <i class="fi fi-rr-user-add"></i>
                <span>Register</span>
            </a>
        <% } %>

        <button id="themeToggle" class="theme-toggle" aria-label="Toggle dark mode">
            <span class="toggle-icon">🌙</span>
        </button>
    </nav>

    <!-- Mobile controls -->
    <div class="mobile-controls">
        <button id="themeToggleMobile" class="theme-toggle" aria-label="Toggle dark mode">
            <span class="toggle-icon">🌙</span>
        </button>
        <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
    </div>
</header>

<!-- Mobile search -->
<div class="mobile-search-bar">
    <form class="search-form" action="/search" method="GET">
        <div class="search-wrap">
            <i class="fi fi-rr-search search-icon"></i>
            <input type="text" name="q" class="search-input"
                   placeholder="Search artworks..."
                   autocomplete="off">
        </div>
    </form>
</div>

<!-- Mobile menu -->
    <!-- Mobile nav -->
    <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
        <nav class="mobile-nav">
            <a href="/" class="mobile-nav-link">
                <i class="fi fi-rr-home"></i> Explore Gallery
            </a>
            <% if (currentUser) { %>
                <a href="/new" class="mobile-nav-link">
                    <i class="fi fi-rr-plus"></i> New Post
                </a>
                <a href="/profile/<%= currentUser.username %>" class="mobile-nav-link">
                    <i class="fi fi-rr-user"></i> My Profile
                </a>
                <form action="/logout" method="POST" style="margin:0">
                    <button type="submit" class="mobile-nav-link mobile-nav-logout">
                        <i class="fi fi-rr-sign-out-alt"></i> Logout
                    </button>
                </form>
            <% } else { %>
                <a href="/login" class="mobile-nav-link">
                    <i class="fi fi-rr-sign-in-alt"></i> Login
                </a>
                <a href="/register" class="mobile-nav-link mobile-nav-cta">
                    <i class="fi fi-rr-user-add"></i> Register
                </a>
            <% } %>
        </nav>
    </div>
<div class="menu-backdrop" id="menuBackdrop"></div>

<main class="main-content">
